@model BookingItemViewModel
@{
    ViewData["Title"] = $"Appointment Details #{Model.Id.ToString().Substring(0, 8)}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4 border-bottom pb-3">
                <div>
                    <span class="badge @Model.StatusBadgeClass badge-status mb-2">@Model.Status</span>
                    <h3 class="fw-bold mb-1">Appointment Confirmation</h3>
                    <p class="text-muted small mb-0">Booking ID: <code>@Model.Id</code></p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Appointments</a>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold">Provider Information</h6>
                    <h5 class="fw-bold mb-1">@Model.ProviderName</h5>
                    <p class="text-muted small mb-0">Service: <strong>@Model.ServiceName</strong></p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold">Scheduled Time</h6>
                    <h5 class="fw-bold text-primary mb-1">@Model.SlotDate.ToString("dddd, MMMM dd, yyyy")</h5>
                    <p class="text-muted small mb-0">@Model.StartTime.ToString("hh:mm tt") - @Model.EndTime.ToString("hh:mm tt") (30 minutes)</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold">Customer Details</h6>
                    <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <p class="mb-0"><strong>Phone:</strong> @Model.CustomerPhone</p>
                    }
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold">Pricing &amp; Payment</h6>
                    <div class="fs-4 fw-bold text-success mb-1">&#8377;@Model.TotalPrice.ToString("N0")</div>
                    <span class="badge bg-light text-muted border">Pay at clinic / venue (UPI &bull; Cash &bull; Cards)</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.CustomerNotes))
            {
                <div class="p-3 bg-light rounded border mb-4">
                    <span class="fw-bold small d-block mb-1">&#128221; Customer Special Instructions:</span>
                    <p class="text-muted small mb-0">@Model.CustomerNotes</p>
                </div>
            }

            @if (Model.Status == BookingStatus.Cancelled && !string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div class="alert alert-danger mb-4">
                    <strong class="d-block">&#9888; Cancellation Record:</strong>
                    <span>@Model.CancellationReason</span>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                <small class="text-muted">Booked on @Model.CreatedAt.ToString("g") UTC</small>
                @if (Model.CanCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm px-3">Cancel Appointment</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
