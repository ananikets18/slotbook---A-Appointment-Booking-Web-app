@{
    ViewData["Title"] = "Setup Provider Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="custom-card p-4 p-md-5">
            <h3 class="fw-bold mb-2">Setup Your Business Profile</h3>
            <p class="text-muted">Enter your business details to start accepting customer appointments.</p>

            <form asp-action="ProfileSetup" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Business or Clinic Name</label>
                    <input type="text" name="BusinessName" class="form-control" placeholder="e.g. Downtown Dental Care" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="Category" class="form-select" required>
                        <option value="Clinic">Clinic / Medical Practice</option>
                        <option value="Salon">Salon / Barber / Spa</option>
                        <option value="Tutor">Tutor / Academy / Instructor</option>
                        <option value="General">General Consultation</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Tell customers about your expertise and services..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Physical Address / Location</label>
                    <input type="text" name="Address" class="form-control" placeholder="123 Main St, Suite 400" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Contact Phone Number</label>
                    <input type="tel" name="ContactPhone" class="form-control" placeholder="+1 (555) 000-0000" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">Save Profile &amp; Go to Dashboard</button>
            </form>
        </div>
    </div>
</div>
