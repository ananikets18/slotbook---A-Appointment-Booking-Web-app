@model ManageSlotsViewModel
@{
    ViewData["Title"] = "Manage Slots";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">Time Slots Manager</h2>
        <p class="text-muted mb-0">Generate and inspect fixed 30-minute availability slots (09:00 AM - 05:00 PM).</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Dashboard</a>
</div>

<div class="row g-4">
    <!-- Batch Slot Generator Tool -->
    <div class="col-lg-5">
        <div class="custom-card p-4">
            <h5 class="fw-bold mb-2">&#9874;&#65039; Batch Slot Generator</h5>
            <p class="text-muted small">Generates standard 30-minute intervals (16 slots/day) between 09:00 and 17:00 for the chosen range.</p>

            <form asp-action="GenerateSlots" method="post" class="mt-3">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-semibold">From Date:</label>
                    <input type="date" name="fromDate" value="@Model.GenerateFromDate.ToString("yyyy-MM-dd")"
                           min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">To Date:</label>
                    <input type="date" name="toDate" value="@Model.GenerateToDate.ToString("yyyy-MM-dd")"
                           min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                    <small class="text-muted">Maximum 60 days per batch. Existing dates are safely skipped without duplicate errors.</small>
                </div>

                <div class="p-3 bg-light rounded border mb-3 small">
                    <span class="fw-bold text-primary d-block mb-1">Standard Daily Schedule:</span>
                    <span>16 slots/day &bull; 09:00 to 17:00 &bull; 30-min each</span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                    Generate 30-Min Slots
                </button>
            </form>
        </div>
    </div>

    <!-- Slots Viewer by Date -->
    <div class="col-lg-7">
        <div class="custom-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0">Slots on @Model.SelectedDate.ToString("dd MMM yyyy")</h5>
                <form method="get" asp-action="Slots" class="d-flex align-items-center gap-2">
                    <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="this.form.submit()" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">Inspect</button>
                </form>
            </div>

            @if (Model.Slots.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <div class="display-4 mb-2">&#128197;</div>
                    <h6>No slots generated for this date.</h6>
                    <p class="small">Use the generator on the left to create 16 standard slots for this day.</p>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
                    <span>Total Slots: <strong>@Model.Slots.Count</strong></span>
                    <span>Available: <strong class="text-success">@Model.Slots.Count(s => !s.IsBooked)</strong> &bull; Booked: <strong class="text-danger">@Model.Slots.Count(s => s.IsBooked)</strong></span>
                </div>

                <div class="slot-grid">
                    @foreach (var slot in Model.Slots)
                    {
                        var isBooked = slot.IsBooked;
                        <div class="slot-btn @(isBooked ? "booked" : "")" style="cursor: default;">
                            <div>@slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")</div>
                            <small class="d-block mt-1 @(isBooked ? "text-danger fw-bold" : "text-success")">
                                @(isBooked ? "Booked" : "Available")
                            </small>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
