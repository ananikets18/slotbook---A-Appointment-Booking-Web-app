@model ProviderDashboardViewModel
@{
    ViewData["Title"] = $"{Model.Provider.BusinessName} - Provider Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.Provider.BusinessName</h2>
            <span class="badge bg-primary">@Model.Provider.Category</span>
        </div>
        <p class="text-muted mb-0">Provider Management Portal &bull; Real-time Booking Control</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Services" class="btn btn-outline-primary fw-semibold">&#9881;&#65039; Manage Services</a>
        <a asp-action="Slots" class="btn btn-outline-secondary fw-semibold">&#128197; Manage Slots</a>
    </div>
</div>

<!-- Metrics Overview Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-3 mb-4">
    <div class="col">
        <div class="custom-card p-3 text-center border-start border-4 border-warning">
            <span class="text-muted small fw-semibold text-uppercase">Pending Approval</span>
            <div class="fs-3 fw-bold text-warning mt-1">@Model.PendingCount</div>
        </div>
    </div>
    <div class="col">
        <div class="custom-card p-3 text-center border-start border-4 border-success">
            <span class="text-muted small fw-semibold text-uppercase">Confirmed</span>
            <div class="fs-3 fw-bold text-success mt-1">@Model.ConfirmedCount</div>
        </div>
    </div>
    <div class="col">
        <div class="custom-card p-3 text-center border-start border-4 border-primary">
            <span class="text-muted small fw-semibold text-uppercase">Completed</span>
            <div class="fs-3 fw-bold text-primary mt-1">@Model.CompletedCount</div>
        </div>
    </div>
    <div class="col">
        <div class="custom-card p-3 text-center border-start border-4 border-info">
            <span class="text-muted small fw-semibold text-uppercase">Active Services</span>
            <div class="fs-3 fw-bold text-info mt-1">@Model.TotalServicesCount</div>
        </div>
    </div>
    <div class="col">
        <div class="custom-card p-3 text-center border-start border-4 border-dark">
            <span class="text-muted small fw-semibold text-uppercase">Completed Revenue</span>
            <div class="fs-3 fw-bold text-dark mt-1">&#8377;@Model.TotalRevenue.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Bookings Management Table -->
<div class="custom-card">
    <div class="card-header-clean d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Customer Appointment Requests</h5>
        <span class="text-muted small">Total: @Model.RecentBookings.Count appointments</span>
    </div>

    @if (Model.RecentBookings.Count == 0)
    {
        <div class="p-5 text-center text-muted">
            <p class="fs-5 mb-2">No bookings recorded yet.</p>
            <small>Make sure you have generated slots for upcoming dates so customers can book!</small>
            <div class="mt-3">
                <a asp-action="Slots" class="btn btn-primary btn-sm">Generate Upcoming Slots</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Date &amp; Time</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Service</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end pe-4">Workflow Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@b.SlotDate.ToString("ddd, dd MMM yyyy")</div>
                                <div class="text-muted small">@b.StartTime.ToString("hh:mm tt") - @b.EndTime.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@b.CustomerName</div>
                                <div class="text-muted small">@b.CustomerEmail &bull; @(b.CustomerPhone ?? "No phone")</div>
                            </td>
                            <td>
                                <div>@b.ServiceName</div>
                                @if (!string.IsNullOrEmpty(b.CustomerNotes))
                                {
                                    <div class="text-muted small" style="max-width: 220px;" title="@b.CustomerNotes">
                                        Note: <em>@b.CustomerNotes</em>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="fw-bold">&#8377;@b.TotalPrice.ToString("N0")</span>
                            </td>
                            <td>
                                <span class="badge @b.StatusBadgeClass badge-status">@b.Status</span>
                                @if (b.Status == BookingStatus.Cancelled && !string.IsNullOrEmpty(b.CancellationReason))
                                {
                                    <div class="text-danger small mt-1" style="max-width: 160px;">@b.CancellationReason</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1 flex-wrap">
                                    @if (b.Status == BookingStatus.Pending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id" />
                                            <input type="hidden" name="newStatus" value="@BookingStatus.Confirmed" />
                                            <button type="submit" class="btn btn-success btn-sm fw-semibold">
                                                &#10004; Confirm
                                            </button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id" />
                                            <input type="hidden" name="newStatus" value="@BookingStatus.Cancelled" />
                                            <input type="hidden" name="reason" value="Declined by provider" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Decline and cancel this booking?');">
                                                Decline
                                            </button>
                                        </form>
                                    }
                                    else if (b.Status == BookingStatus.Confirmed)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id" />
                                            <input type="hidden" name="newStatus" value="@BookingStatus.Completed" />
                                            <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                                                &#10003; Mark Done
                                            </button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id" />
                                            <input type="hidden" name="newStatus" value="@BookingStatus.Cancelled" />
                                            <input type="hidden" name="reason" value="Cancelled by provider" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancel this confirmed appointment? Slot will be released.');">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small py-1">Terminal</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
