@{
    ViewData["Title"] = "Error";
    var statusCode = ViewBag.StatusCode ?? 500;
    var errorMessage = ViewBag.ErrorMessage ?? "An unexpected error occurred.";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="custom-card p-5">
            <h1 class="display-1 text-danger fw-bold">@statusCode</h1>
            <h3 class="mb-3">Oops! Something went wrong</h3>
            <p class="text-muted mb-4">@errorMessage</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Back to Safety</a>
                <button onclick="history.back()" class="btn btn-outline-secondary px-4">Go Back</button>
            </div>
        </div>
    </div>
</div>
