@using System.Security.Claims
@using AppointmentBooking.Core.Enums

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.Identity.Name ?? User.FindFirst(ClaimTypes.Email)?.Value ?? "User";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="badge bg-light text-primary me-2">@userRole</span>
            <span>@userName</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
            @if (userRole == "Customer")
            {
                <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index">My Appointments</a></li>
                <li><a class="dropdown-item" asp-controller="Providers" asp-action="Index">Find Providers</a></li>
            }
            else if (userRole == "Provider")
            {
                <li><a class="dropdown-item" asp-controller="ProviderDashboard" asp-action="Index">Dashboard Overview</a></li>
                <li><a class="dropdown-item" asp-controller="ProviderDashboard" asp-action="Services">Manage Services</a></li>
                <li><a class="dropdown-item" asp-controller="ProviderDashboard" asp-action="Slots">Manage Slots</a></li>
            }
            else if (userRole == "Admin")
            {
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Portal</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Sign In</a>
    </li>
    <li class="nav-item ms-lg-2">
        <a class="btn btn-outline-light btn-sm px-3 mt-1" asp-controller="Account" asp-action="Register">Get Started</a>
    </li>
}
</ul>
